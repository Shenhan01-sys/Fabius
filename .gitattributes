# Vendored sumber = byte yang punya hash tercatat. Git tidak boleh menyentuh akhirannya.
#
# Kenapa perlu berkas ini: di checkout Windows dengan `core.autocrlf=true`, git senyap-senyap
# menulis ulang LF jadi CRLF. Untuk kode kita sendiri itu tidak apa-apa. Untuk salinan yang
# klaimnya "VERBATIM dari upstream commit X, sha256 = Y" itu merusak dua hal sekaligus:
# byte-nya bukan lagi punya upstream, dan `python _research/vendored_x402.py verify` gagal di
# mesin orang lain sementara lolos di mesin ini - kegagalan yang paling sulit dijelaskan.
contracts/vendor/x402/** -text
docs/upstream-x402/** -text
# Vendor 8004 punya klaim sha256 yang sama; kalau git mengonversi LF->CRLF di jalur ini,
# `VENDORED.json` tidak akan lagi cocok dengan byte-nya di mesin orang lain.
docs/upstream-8004/** -text

# Catatan penarikan (26 Sep): versi pertama berkas ini juga mengunci `universe/**` dan
# `decisions/**`. Akibatnya `git add --renormalize` menulis ulang byte dataset (CRLF -> LF) dan
# `write_universe_manifest.py` langsung melaporkan **2 snapshot TIDAK cocok dengan sha256
# tersimpan** - klaim point-in-time yang kupatahkan sendiri, di sisi yang seharusnya paling aman.
# Dataset tidak punya klaim "verbatim terhadap upstream", jadi tidak ada yang perlu dikunci di
# sini; yang punya klaim itu cuma vendor x402.
# Berkas data yang ditulis MESIN tiap siklus, dan hanya bertambah di ekor.
# Tanpa driver ini, satu commit manusia ke berkas yang sama membuat rantai perekam gagal push
# selamanya (terukur 28 Sep: aliran ⑦ bolong 3 jam 19 menit karena commit-ku sendiri).
#   jsonl   -> union: kedua sisi baris dipertahankan; `record_wallet_flow.py` sudah dedupe
#              by transaction_hash, jadi baris dobel tidak merusak apa pun.
#   manifest-> ours (driver `true` diaktifkan workflow perekam): berkas ini dibikin ulang dari
#              nol tiap siklus, jadiMerge apa pun terhadapnya tidak berarti.
universe/wallet-flow.jsonl  merge=union
universe/watch-prices.jsonl merge=union
universe/bsc-universe.jsonl merge=union
universe/book-depth.jsonl   merge=union
decisions/fast-lane.jsonl   merge=union
# ^ dua berkas yang saya LUPA beri driver saat memasangnya (29 Sep): keduanya ditulis mesin
#   tiap siklus dan hanya bertambah di ekor, sama seperti aliran ⑦ - dan tanpa union, rebase
#   rantai langsung mentok di `UU universe/book-depth.jsonl` (terjadi 10:0xZ, lima dorongan
#   gagal). Pembacanya wajib dedupe: book_prereg pada (sym,update_id), fast_lane pada `kunci`.
universe/*-manifest.txt     merge=ours
# CATATAN: TIDAK ada wildcard `*.json merge=union` di sini. Union pada JSON menghasilkan berkas
# yang tidak bisa di-parse, dan artefak keputusan justru harus bertabrakan kalau dua pihak
# menulisnya - konflik yang kelihatan lebih baik daripada data korup yang hijau.

# Ledger paper maju (M2, F-D75): berkas yang ditulis mesin dan diperiksa lintas OS. Akhiran baris dikunci LF supaya checkout Windows (autocrlf)
# tidak menulis ulang ±5 MB bar dan tidak membuat baris berantai campur. TIDAK ada merge=union di sini: dua penulis yang menambah ke rantai hash yang
# sama HARUS bertabrakan secara terlihat (union menyisipkan catatan dan memutus `prev`); penulis resmi = job paper-ledger (satu, concurrency tunggal).
ledger/** text eol=lf
